[Unit]
Description=9xPublishFast - X & Social Fast Post Queue
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/projects/9xpublishfast
# Absolute path to the nvm-installed Node 22 binary
ExecStart=/home/ubuntu/.nvm/versions/node/v22.23.2/bin/node server/dist/index.js
EnvironmentFile=/home/ubuntu/projects/9xpublishfast/.env
Environment=NODE_ENV=production
Restart=on-failure
RestartSec=5

# The process only needs its own directory.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
