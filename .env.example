# Copy to .env and fill in. Never commit the real .env.

# Secret used to sign session tokens. Generate: openssl rand -hex 32
AUTH_SECRET=

# HTTP port the server listens on (bound to 127.0.0.1)
PORT=8055
HOST=127.0.0.1

# Where the SQLite file and uploaded media live.
# Relative paths resolve from the repo root.
DATA_DIR=./data

# Public origin, used for absolute links. No trailing slash.
PUBLIC_URL=http://localhost:8055

# Max upload size in bytes (default 512MB)
MAX_UPLOAD_BYTES=536870912
